# /etc/agenthive/env — AgentHive operator environment template
#
# OPERATOR MIGRATION GUIDE (P448)
# --------------------------------
# Copy this file to /etc/agenthive/env and fill in the values for your
# deployment. The file is sourced by all AgentHive systemd units via
# EnvironmentFile=/etc/agenthive/env (see agenthive-mcp.service).
#
# CRITICAL: As of P448/V1 (2026-Q2), PGUSER no longer silently falls back to
# "xiaomi". Starting any AgentHive service without PGUSER set will fail with
# AgentHiveConfigError. Set ALL required variables below before restarting.
#
# DEPRECATION SCHEDULE (P448):
#   V1 (2026-Q2, current): missing PGUSER emits a console.warn then throws.
#   V2 (2026-Q3):          the console.warn is removed; only the throw remains.
#
# MISSING FILE FAILURE MODE:
#   If /etc/agenthive/env is absent and PGUSER/PGHOST are not in the process
#   environment, the service will fail at startup with:
#     AgentHiveConfigError: [PG] PGUSER is required but not set.
#       Set PGUSER (and PGHOST, PGDATABASE) in /etc/agenthive/env.
#       See scripts/systemd/env.template for a migration guide.
#
# To apply changes: sudo systemctl daemon-reload && sudo systemctl restart agenthive-mcp

# ── Database (required) ──────────────────────────────────────────────────────
PGHOST=127.0.0.1
# P499: Query clients use PgBouncer (:6432). LISTEN clients bypass via PGPORT_DIRECT.
PGPORT=6432
PGPORT_DIRECT=5432
PGUSER=your_db_user_here
PGDATABASE=your_db_name_here
# Auth: use ~/.pgpass (chmod 600) — do NOT set PGPASSWORD in this file.
# PGPASSWORD is forbidden; see project security policy (feedback_pgpassword_exposure.md).

# ── AgentHive paths (required) ───────────────────────────────────────────────
AGENTHIVE_PROJECT_ROOT=/data/code/AgentHive
AGENTHIVE_WORKTREE_ROOT=/data/code/worktree

# ── MCP / daemon endpoints (required) ───────────────────────────────────────
AGENTHIVE_MCP_URL=http://127.0.0.1:6421/sse
AGENTHIVE_DAEMON_URL=http://127.0.0.1:6420

# ── Provider (optional — defaults inferred from host policy) ─────────────────
# AGENTHIVE_PROVIDER=hermes

# ── PgBouncer (optional — defaults match pgbouncer-provision.sh output) ──────
# PGBOUNCER_HOST=127.0.0.1
# PGBOUNCER_PORT=6432
# PGBOUNCER_ADMIN_USER=pgbouncer_admin

# ── Logging (optional) ───────────────────────────────────────────────────────
# DEBUG_PG=1
# NODE_ENV=production
