[Unit]
Description=PgBouncer — connection pooler for PostgreSQL (AgentHive P499)
Documentation=https://www.pgbouncer.org/
After=postgresql.service network.target
Wants=postgresql.service

[Service]
Type=notify
User=postgres
Group=postgres
EnvironmentFile=-/etc/agenthive/env
ExecStart=/usr/sbin/pgbouncer /etc/pgbouncer/pgbouncer.ini
ExecReload=/bin/kill -HUP $MAINPID
WatchdogSec=30s
NotifyAccess=main
Restart=always
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=mixed

# Harden the service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/pgbouncer /run/pgbouncer

[Install]
WantedBy=multi-user.target
