# AgentHive per-tenant backup cron — generated by project_create saga (P495/P509)
# Deploy to: /etc/cron.d/agenthive-tenant-{{SLUG}}
# DO NOT edit by hand; regenerate via: scripts/ops/install-tenant-ops.sh {{SLUG}}

# Daily backup at 03:15 UTC (staggered by tenant to spread I/O)
# Adjust minute offset: 15 + (tenant_ordinal * 5) % 45 to avoid thundering herd.
15 3 * * * agenthive /usr/local/bin/agenthive-tenant-backup.sh {{SLUG}} prod >> /var/log/agenthive/backup-{{SLUG}}.log 2>&1

# Daily retention + disk cap enforcement at 05:00 UTC (after backup window)
0 5 * * * agenthive /usr/local/bin/agenthive-retention-prune.sh {{SLUG}} >> /var/log/agenthive/retention-{{SLUG}}.log 2>&1

# Monthly restore test (day = 1 + ordinal % 28, staggered per tenant)
# Example: tenant ordinal 0 → day 1, ordinal 1 → day 2, etc.
0 2 {{RESTORE_DAY}} * * root /usr/local/bin/agenthive-restore-test.sh {{SLUG}} >> /var/log/agenthive/restore-test.log 2>&1
