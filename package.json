{
  "name": "agentRoadmap",
  "version": "0.53.0",
  "type": "module",
  "module": "src/apps/cli.ts",
  "files": [
    "roadmap",
    "completions",
    "scripts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "roadmap": "scripts/cli.cjs",
    "agenthive": "scripts/agenthive.cjs",
    "hive": "scripts/hive.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@clack/core": "1.0.1",
    "@clack/prompts": "1.0.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@tailwindcss/cli": "4.1.18",
    "@types/bun": "1.3.6",
    "@types/glob": "^8.1.0",
    "@types/jsdom": "27.0.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@types/react-router-dom": "5.3.3",
    "@types/ws": "^8.18.1",
    "@uiw/react-markdown-preview": "5.1.5",
    "@uiw/react-md-editor": "4.0.11",
    "chalk": "^5.6.2",
    "commander": "14.0.2",
    "esbuild": "^0.28.0",
    "fuse.js": "7.1.0",
    "glob": "^13.0.6",
    "gray-matter": "4.0.3",
    "install": "0.13.0",
    "jsdom": "27.4.0",
    "mermaid": "^11.14.0",
    "neo-neo-bblessed": "1.0.9",
    "picocolors": "1.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.12.0",
    "react-tooltip": "5.30.0",
    "tailwindcss": "4.1.18",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "agent-roadmap-darwin-arm64": "0.53.0",
    "agent-roadmap-darwin-x64": "0.53.0",
    "agent-roadmap-linux-arm64": "0.53.0",
    "agent-roadmap-linux-x64": "0.53.0",
    "agent-roadmap-windows-x64": "0.53.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "node --import jiti/register --test $(find tests -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) | sort)",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check .",
    "check:types": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.check.json --noEmit",
    "check:publish": "node scripts/check-publish-hygiene.mjs",
    "audit:sql": "node --import jiti/register scripts/ci/audit-sql-columns.ts",
    "audit:message-type-drift": "node --import jiti/register scripts/check-message-type-drift.ts",
    "audit:migration-continuity": "node --import jiti/register scripts/verify-migration-continuity.ts",
    "audit:bundle": "esbuild scripts/mcp-sse-server.js --bundle --packages=external --log-level=error",
    "audit:dispatch-selects": "node --import jiti/register scripts/ci/check-dispatch-proposal-selects.ts",
    "audit:mcp-param-fidelity": "node --import jiti/register scripts/ci/check-mcp-param-fidelity.ts",
    "audit:migrations": "bash scripts/ci/check-migration-drops.sh",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i src/apps/dashboard-web/styles/source.css -o src/apps/dashboard-web/styles/style.css --minify",
    "build:web": "node scripts/build-web.cjs",
    "build:web:watch": "node scripts/build-web.cjs --watch",
    "operator:issue": "node --import jiti/register scripts/operator-token.ts issue",
    "operator:list": "node --import jiti/register scripts/operator-token.ts list",
    "operator:revoke": "node --import jiti/register scripts/operator-token.ts revoke",
    "authority:grant": "node --import jiti/register scripts/authority-grant.ts",
    "build": "npm run build:css && node scripts/build-dist.cjs && node scripts/build-agenthive.cjs && npm run build:web -- --js-only",
    "cli": "npm run build:css && node --import jiti/register src/apps/cli.ts",
    "hive": "node --import jiti/register src/apps/hive-cli/index.ts",
    "build:agenthive": "node scripts/build-agenthive.cjs",
    "board": "node --import jiti/register scripts/roadmap-board.ts",
    "agents:stop": "node --import jiti/register scripts/agent-stop.ts",
    "cubics:repair-worktrees": "node --import jiti/register scripts/repair-cubic-worktrees.ts",
    "tui": "node --import jiti/register src/apps/tui/index.ts",
    "mcp": "node --import jiti/register src/apps/cli.ts mcp start",
    "mcp:propose-state-machine": "node --import jiti/register scripts/propose-state-machine-issues.ts",
    "update-nix": "sh scripts/update-nix.sh",
    "release": "git push github main --tags && git push origin main --tags",
    "release:patch": "npm version patch && npm run sync-deps && npm run release",
    "release:minor": "npm version minor && npm run sync-deps && npm run release",
    "release:major": "npm version major && npm run release",
    "sync-deps": "TAG=$(jq -r .version package.json) && jq --arg v \"$TAG\" '.optionalDependencies |= with_entries(.value = $v)' package.json > tmp.json && mv tmp.json package.json && git add package.json && git commit --amend --no-edit",
    "gate": "bash scripts/ci/gate.sh",
    "gate:full": "bash scripts/ci/gate.sh --full",
    "gate:full:smoke": "bash scripts/ci/gate.sh --full --mcp-smoke",
    "check:hardcoded": "bash scripts/check-hardcoded.sh",
    "check:credential-env": "bash scripts/check-credential-env.sh",
    "check:migrations": "tsx scripts/check-migration-prefixes.ts",
    "migrate": "node --import jiti/register scripts/migrate.ts",
    "migrate:status": "node --import jiti/register scripts/migrate.ts --status",
    "migrate:dry-run": "node --import jiti/register scripts/migrate.ts --dry-run",
    "migrate:check": "node --import jiti/register scripts/migrate.ts --check",
    "deploy": "bash scripts/deploy.sh",
    "check:message-type-drift": "node --import jiti/register scripts/check-message-type-drift.ts",
    "check:migration-continuity": "node --import jiti/register scripts/verify-migration-continuity.ts",
    "check:capability-coverage": "node --import jiti/register scripts/orchestrator-capability-coverage-check.ts",
    "scan": "node --import jiti/register scripts/scan-hardcoding.ts",
    "scan:workflow-states": "node --import jiti/register scripts/scan-hardcoding.ts --rule-tag workflow --fail-on high --baseline .workflow-states-baseline.jsonl",
    "scan:secrets": "node --import jiti/register scripts/scan-hardcoding.ts --rules packages/agenthive-scan-rules-secrets/rules --fail-on high --baseline .secrets-baseline.jsonl",
    "scan:multi-tenant": "node --import jiti/register scripts/scan-hardcoding.ts --rules packages/agenthive-scan-rules-multi-tenant/rules --fail-on high --baseline .multi-tenant-baseline.jsonl",
    "scan:agenthive": "node --import jiti/register scripts/scan-hardcoding.ts --rules packages/agenthive-scan-rules-agenthive/rules --fail-on high --baseline .agenthive-baseline.jsonl",
    "scan:self-test": "node --import jiti/register scripts/scan-hardcoding.ts --self-test",
    "check:mcp-bundle": "node scripts/check-mcp-bundle.mjs",
    "check:message-drift": "node --import jiti/register scripts/check-message-type-drift.ts"
  },
  "author": "Alex Gavrilescu (https://github.com/MrLesk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentroadmap/agentRoadmap.git"
  },
  "bugs": {
    "url": "https://github.com/agentroadmap/agentRoadmap/issues"
  },
  "homepage": "https://roadmap.md",
  "keywords": [
    "cli",
    "markdown",
    "kanban",
    "state",
    "project-management",
    "roadmap",
    "agents",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "autonomous",
    "multi-agent",
    "llm-tools"
  ],
  "license": "MIT",
  "trustedDependencies": [
    "@biomejs/biome",
    "node-pty"
  ],
  "dependencies": {
    "@types/pg": "^8.20.0",
    "clsx": "^2.1.1",
    "discord.js": "^14.26.3",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.1",
    "p-limit": "^7.3.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.9.0",
    "ws": "^8.20.0"
  }
}
