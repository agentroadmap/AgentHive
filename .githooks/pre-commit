#!/usr/bin/env bash
# P404: Reject commits that track tmp/ artifacts or ephemeral agent output.
# Install: git config core.hooksPath .githooks
# Or run: npm run hooks:install

set -euo pipefail

# Files staged for commit
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

BLOCKED=()

while IFS= read -r file; do
  # Block tmp/ files at any depth
  if [[ "$file" == tmp/* || "$file" == */tmp/* ]]; then
    BLOCKED+=("$file")
    continue
  fi

  # Block common ephemeral agent artifact extensions in docs/ or project root
  case "$file" in
    docs/*-report.md | docs/*-review.md | docs/arch-*.md | \
    *-ship-report.md | *-gate-report.md | *-verification.md)
      BLOCKED+=("$file")
      ;;
  esac
done <<< "$STAGED"

if [ ${#BLOCKED[@]} -gt 0 ]; then
  echo "[pre-commit] Blocking commit: ephemeral agent artifacts must not be tracked." >&2
  for f in "${BLOCKED[@]}"; do
    echo "  blocked: $f" >&2
  done
  echo "  Use AGENT_SCRATCH_DIR for ephemeral output, or proposal_discussions for reports." >&2
  exit 1
fi

# MCP bundle integrity gate: src/apps/mcp-server is NOT covered by tsconfig.check,
# so dup-declaration merge corruption otherwise reaches main and crash-loops
# agenthive-mcp. Run the fast esbuild gate whenever a src TS file is staged.
if echo "$STAGED" | grep -qE '^src/.*\.tsx?$'; then
  if ! node scripts/check-mcp-bundle.mjs >&2; then
    echo "[pre-commit] Blocking commit: MCP import graph has duplicate-declaration corruption (see above)." >&2
    exit 1
  fi
fi

# P1107 AC-8: message_type enum/DB drift guard — runs only when messaging types
# or migrations are staged, keeping the commit fast for unrelated changes.
if echo "$STAGED" | grep -qE '^src/infra/messaging/types\.tsx?$|^scripts/migrations/'; then
  if ! npm run --silent check:message-type-drift >&2; then
    echo "[pre-commit] Blocking commit: message_type enum/DB constraint drift detected (see above)." >&2
    exit 1
  fi
fi

exit 0
