[Unit]
# P299-E: Per-agency liaison template unit.
# Instantiate one per active agency: `systemctl start agenthive-liaison@claude-agency-bot`.
# %i is the agency identity (URL-encoded if it contains '/'; e.g. "claude%2Fagency-bot").
# %I is the unescaped form used as AGENCY_ID.
Description=AgentHive Liaison for agency %I
After=network.target postgresql.service agenthive-mcp.service agenthive-orchestrator.service
Requires=agenthive-mcp.service

[Service]
Type=simple
User=gary
Group=gary
WorkingDirectory=/data/code/AgentHive
EnvironmentFile=/etc/agenthive/env
# Per-agency env file (optional). Operator generates one per active agency
# row with at minimum: AGENCY_PROVIDER, AGENCY_HOST_ID, AGENCY_SIGNING_KEY,
# AGENCY_CAPABILITIES, AGENCY_WORKTREE.
EnvironmentFile=-/etc/agenthive/agency-%i.env
Environment=NODE_ENV=production
Environment=PATH=/home/gary/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/gary
# AGENCY_ID is unescaped %I — use AGENTHIVE_AGENT_IDENTITY too so child spawns
# inherit the canonical identity shape.
Environment=AGENCY_ID=%I
Environment=AGENTHIVE_AGENT_IDENTITY=%I
ExecStart=/home/gary/.nvm/versions/node/v24.14.0/bin/node --import jiti/register scripts/start-liaison.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
KillSignal=SIGTERM
# Each liaison handles one agency, so memory + CPU caps stay small.
MemoryMax=512M
CPUQuota=25%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthive-liaison-%i

[Install]
WantedBy=multi-user.target
