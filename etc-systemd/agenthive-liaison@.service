[Unit]
Description=AgentHive Liaison Hub (%i)
After=network.target postgresql.service agenthive-mcp.service
Requires=agenthive-mcp.service

[Service]
Type=simple
User=gary
Group=gary
WorkingDirectory=/data/code/AgentHive
# Global env (DB creds, base URLs, etc.)
EnvironmentFile=/etc/agenthive/env
# Per-instance env — filename uses the systemd instance name (matches %i exactly).
# Typical contents: AGENCY_PROVIDER=anthropic AGENCY_HOST_ID=bot
EnvironmentFile=-/etc/agenthive/liaison-%i.env
Environment=NODE_ENV=production
Environment=PATH=/home/gary/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/gary
# Agency identity is the systemd instance name (e.g. claude-agency-bot)
Environment=AGENCY_ID=%i
ExecStart=/home/gary/.nvm/versions/node/v24.14.0/bin/node --import jiti/register scripts/start-liaison.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
KillSignal=SIGTERM
MemoryMax=512M
CPUQuota=50%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthive-liaison-%i

[Install]
WantedBy=multi-user.target
