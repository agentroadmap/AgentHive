[Unit]
Description=AgentHive Agency Runtime (%i)
After=network.target postgresql.service agenthive-mcp.service
Requires=agenthive-mcp.service

[Service]
Type=simple
User=gary
Group=gary
WorkingDirectory=/data/code/AgentHive
# Global env (DB creds, base URLs, etc.)
EnvironmentFile=/etc/agenthive/env
# Per-instance env (optional). Filename uses systemd's escaped instance form
# (matches %i exactly). Typical contents: AGENTHIVE_AGENT_PROVIDER=<provider>,
# CLAUDE_BIN/CODEX_BIN/etc., AGENTHIVE_AGENT_PROJECTS=<csv>.
EnvironmentFile=-/etc/agenthive/agency-%i.env
Environment=NODE_ENV=production
Environment=PATH=/home/gary/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/gary
# Identity is the systemd instance name. Use a no-slash format (e.g. claude-agency-bot)
# for new agencies; legacy slash-format identities (claude/agency-bot, copilot/agency-gary)
# stay on their existing standalone units instead.
Environment=AGENCY_ID=%i
Environment=AGENCY_HOST_ID=bot
# Map legacy per-instance env var to the liaison env var name
Environment=AGENCY_PROVIDER=${AGENTHIVE_AGENT_PROVIDER}
ExecStart=/home/gary/.nvm/versions/node/v24.14.0/bin/node --import jiti/register scripts/start-liaison.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
KillSignal=SIGTERM
MemoryMax=512M
CPUQuota=50%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthive-agency-%i

[Install]
WantedBy=multi-user.target
