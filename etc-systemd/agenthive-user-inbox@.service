[Unit]
Description=AgentHive User Inbox Consumer (%i)
After=network.target postgresql.service agenthive-mcp.service
Requires=agenthive-mcp.service

[Service]
Type=simple
User=gary
Group=gary
WorkingDirectory=/data/code/AgentHive
EnvironmentFile=/etc/agenthive/env
Environment=NODE_ENV=production
Environment=PATH=/home/gary/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/gary
# Instance name becomes the operator identity (e.g. "gary" → user/gary)
Environment=USER_INBOX_OPERATOR=%i
ExecStart=/usr/local/bin/bun scripts/user-inbox-consumer.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=256M
CPUQuota=20%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthive-user-inbox-%i

[Install]
WantedBy=multi-user.target
