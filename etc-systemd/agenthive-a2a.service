[Unit]
Description=AgentHive A2A Message Dispatcher
Documentation=https://github.com/agentroadmap/agentRoadmap
After=network-online.target postgresql.service agenthive-mcp.service
Wants=network-online.target agenthive-mcp.service

[Service]
Type=simple
User=gary
Group=gary
WorkingDirectory=/data/code/AgentHive
Environment=NODE_ENV=production
Environment=PATH=/home/gary/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/gary
ExecStart=/home/gary/.nvm/versions/node/v24.14.0/bin/node --import jiti/register scripts/a2a-dispatcher.ts
Restart=always
RestartSec=5
# P1106-E: give the dispatcher up to 2min to drain and close the pg pool on SIGTERM.
# Matches SHUTDOWN_DRAIN_MS (90s) in scripts/a2a-dispatcher.ts plus headroom.
TimeoutStopSec=120
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthive-a2a
EnvironmentFile=-%h/.agenthive.env
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
