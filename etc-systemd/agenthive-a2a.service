[Unit]
Description=AgentHive A2A Message Dispatcher
Documentation=https://gitlab.local/agenthive
After=network.target postgresql.service agenthive-mcp.service
Requires=agenthive-mcp.service

[Service]
Type=simple
User=gary
Group=gary
WorkingDirectory=/data/code/AgentHive-live
EnvironmentFile=/etc/agenthive/env
Environment=NODE_ENV=production
Environment=PATH=/home/gary/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/gary
# P267: drain up to 90s before systemd escalates to SIGKILL
Environment=AGENTHIVE_A2A_DRAIN_MS=90000
ExecStart=/home/gary/.nvm/versions/node/v24.14.0/bin/node --import jiti/register scripts/a2a-dispatcher.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
KillSignal=SIGTERM
MemoryMax=256M
CPUQuota=25%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthive-a2a

[Install]
WantedBy=multi-user.target
