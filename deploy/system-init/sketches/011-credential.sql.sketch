-- ============================================================
-- SKETCH 011 — P901 Phase 1: Credential schema for hiveCentral
-- ============================================================
-- Target DB:  hiveCentral
-- Author:     P901 researcher pass (adam, 2026-05-16)
-- Status:     SKETCH — requires dry-run validation before production use
--
-- SCOPE:
--   1. control_credential schema (from 005-credential.sql, P596) — idempotent
--   2. vault_provider, credential, credential_grant, rotation_log — idempotent
--   3. RLS policies on control_credential.credential (NEW — not in 005)
--      - FORCE ROW LEVEL SECURITY
--      - admin_bypass policy  (pg_has_role check)
--      - owner_rw policy      (app.current_principal_did session var)
--      - grantee_select policy (via credential_grant join)
--
-- SCHEMA NAME (Finding 3 / AC-8):
--   MUST be `control_credential` throughout. The 005-credential.sql DDL file
--   uses this name correctly. All application code must use `control_credential.*`.
--   The name `credential` (without prefix) is WRONG and was corrected in P901.
--
-- VAULT ADAPTER GAP (Finding 7 / AC-8):
--   src/shared/vault/index.ts routes by AGENTHIVE_VAULT_KIND env var only.
--   It NEVER reads from control_credential.vault_provider or
--   control_credential.credential. P1072 (Vault Adapter DB Integration) tracks
--   the wire-up. This schema is complete but the vault adapter integration
--   is deferred to P1072 (blocked by P826 and P429).
--
-- RLS SESSION VARIABLE:
--   Batch jobs and cron callers must SET app.current_principal_did before
--   any query targeting control_credential.credential, otherwise RLS denies
--   access. Add assertion in pool acquisition wrapper (Phase 3 work item).
--
-- SEARCH PATH WARNING (Finding 15):
--   control_credential is not in getControlPool() search_path.
--   All SQL must use fully-qualified control_credential.* names.
-- ============================================================

\set ON_ERROR_STOP on

BEGIN;

-- ============================================================
-- 1. Schema (idempotent — from 005-credential.sql)
-- ============================================================
CREATE SCHEMA IF NOT EXISTS control_credential;

COMMENT ON SCHEMA control_credential IS
  'Credential management layer: vault backends, named secret references, '
  'access grants, and append-only rotation log. '
  'NEVER stores actual secret values; only metadata and vault paths.';

-- ============================================================
-- 2. Trigger helper
-- ============================================================
CREATE OR REPLACE FUNCTION control_credential.set_updated_at()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
  NEW.updated_at := clock_timestamp();
  RETURN NEW;
END;
$$;

-- ============================================================
-- 3. vault_provider — registered secret backends (idempotent)
-- ============================================================
CREATE TABLE IF NOT EXISTS control_credential.vault_provider (
  id               BIGSERIAL    PRIMARY KEY,
  slug             TEXT         UNIQUE NOT NULL,
  provider_type    TEXT         NOT NULL
                               CHECK (provider_type IN ('env','file','hcp_vault','aws_secrets')),
  config           JSONB        NOT NULL DEFAULT '{}',
  owner_did        TEXT         NOT NULL,
  lifecycle_status TEXT         NOT NULL DEFAULT 'active'
                               CHECK (lifecycle_status IN ('active','deprecated','retired','blocked')),
  deprecated_at    TIMESTAMPTZ,
  retire_after     TIMESTAMPTZ,
  notes            TEXT,
  created_at       TIMESTAMPTZ  NOT NULL DEFAULT now(),
  updated_at       TIMESTAMPTZ  NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS vault_provider_type_active
  ON control_credential.vault_provider (provider_type)
  WHERE lifecycle_status = 'active';

DO $$ BEGIN
  CREATE TRIGGER set_updated_at_vault_provider
    BEFORE UPDATE ON control_credential.vault_provider
    FOR EACH ROW EXECUTE FUNCTION control_credential.set_updated_at();
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

-- ============================================================
-- 4. credential — named secret references (idempotent)
-- ============================================================
CREATE TABLE IF NOT EXISTS control_credential.credential (
  id                       BIGSERIAL    PRIMARY KEY,
  credential_name          TEXT         UNIQUE NOT NULL,
  vault_provider_id        BIGINT       NOT NULL
                                        REFERENCES control_credential.vault_provider (id) ON DELETE RESTRICT,
  vault_path               TEXT         NOT NULL,
  credential_type          TEXT         NOT NULL
                                        CHECK (credential_type IN ('api_key','oauth_token','tls_cert','db_password','generic')),
  last_rotated_at          TIMESTAMPTZ,
  rotation_interval_hours  INT,
  owner_did                TEXT         NOT NULL,
  lifecycle_status         TEXT         NOT NULL DEFAULT 'active'
                                        CHECK (lifecycle_status IN ('active','deprecated','retired','blocked')),
  deprecated_at            TIMESTAMPTZ,
  retire_after             TIMESTAMPTZ,
  notes                    TEXT,
  created_at               TIMESTAMPTZ  NOT NULL DEFAULT now(),
  updated_at               TIMESTAMPTZ  NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS credential_provider_active
  ON control_credential.credential (vault_provider_id)
  WHERE lifecycle_status = 'active';

CREATE INDEX IF NOT EXISTS credential_rotation_due
  ON control_credential.credential (last_rotated_at, rotation_interval_hours)
  WHERE lifecycle_status = 'active' AND rotation_interval_hours IS NOT NULL;

DO $$ BEGIN
  CREATE TRIGGER set_updated_at_credential
    BEFORE UPDATE ON control_credential.credential
    FOR EACH ROW EXECUTE FUNCTION control_credential.set_updated_at();
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

-- ============================================================
-- 5. credential_grant — per-grantee access grants (idempotent)
-- ============================================================
CREATE TABLE IF NOT EXISTS control_credential.credential_grant (
  id             BIGSERIAL    PRIMARY KEY,
  credential_id  BIGINT       NOT NULL
                              REFERENCES control_credential.credential (id) ON DELETE CASCADE,
  grantee_type   TEXT         NOT NULL
                              CHECK (grantee_type IN ('principal','agency','project','model_route')),
  grantee_id     TEXT         NOT NULL,
  granted_by     TEXT         NOT NULL,
  expires_at     TIMESTAMPTZ,
  created_at     TIMESTAMPTZ  NOT NULL DEFAULT now(),
  UNIQUE (credential_id, grantee_type, grantee_id)
);

CREATE INDEX IF NOT EXISTS credential_grant_grantee
  ON control_credential.credential_grant (grantee_type, grantee_id);

CREATE INDEX IF NOT EXISTS credential_grant_expiry
  ON control_credential.credential_grant (expires_at)
  WHERE expires_at IS NOT NULL;

-- ============================================================
-- 6. rotation_log — append-only audit trail (idempotent)
-- ============================================================
CREATE TABLE IF NOT EXISTS control_credential.rotation_log (
  id              BIGSERIAL    PRIMARY KEY,
  credential_id   BIGINT       NOT NULL
                               REFERENCES control_credential.credential (id) ON DELETE RESTRICT,
  rotated_by      TEXT         NOT NULL,
  outcome         TEXT         NOT NULL CHECK (outcome IN ('success','failure')),
  error_message   TEXT,
  rotated_at      TIMESTAMPTZ  NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS rotation_log_credential_time
  ON control_credential.rotation_log (credential_id, rotated_at DESC);

REVOKE UPDATE, DELETE ON control_credential.rotation_log FROM PUBLIC;

CREATE OR REPLACE FUNCTION control_credential.deny_rotation_log_mutation()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
  RAISE EXCEPTION 'control_credential.rotation_log is append-only (op=%)', TG_OP;
END;
$$;

DO $$ BEGIN
  CREATE TRIGGER rotation_log_no_update
    BEFORE UPDATE ON control_credential.rotation_log
    FOR EACH ROW EXECUTE FUNCTION control_credential.deny_rotation_log_mutation();
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

DO $$ BEGIN
  CREATE TRIGGER rotation_log_no_delete
    BEFORE DELETE ON control_credential.rotation_log
    FOR EACH ROW EXECUTE FUNCTION control_credential.deny_rotation_log_mutation();
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

-- ============================================================
-- 7. RLS policies on control_credential.credential (NEW)
-- AC-10: FORCE ROW LEVEL SECURITY with three policies
--
-- Session variable: app.current_principal_did must be SET before
-- any query that relies on owner_rw or grantee_select policies.
-- Batch jobs: SET LOCAL app.current_principal_did = 'did:agenthive:scheduler'
-- ============================================================
ALTER TABLE control_credential.credential ENABLE ROW LEVEL SECURITY;
ALTER TABLE control_credential.credential FORCE ROW LEVEL SECURITY;

-- Policy 1: admin_bypass — superusers and agenthive_admin bypass RLS
DROP POLICY IF EXISTS admin_bypass ON control_credential.credential;
CREATE POLICY admin_bypass
  ON control_credential.credential
  USING (
    pg_has_role(current_user, 'agenthive_admin', 'MEMBER')
    OR current_user = 'agenthive_admin'
  );

COMMENT ON POLICY admin_bypass ON control_credential.credential IS
  'agenthive_admin role members bypass all RLS checks. '
  'Used by the rotation scheduler and platform operations.';

-- Policy 2: owner_rw — owner can read and write their own credentials
-- Requires SET LOCAL app.current_principal_did = '<DID>' before queries.
DROP POLICY IF EXISTS owner_rw ON control_credential.credential;
CREATE POLICY owner_rw
  ON control_credential.credential
  FOR ALL
  USING (
    owner_did = current_setting('app.current_principal_did', true)
  )
  WITH CHECK (
    owner_did = current_setting('app.current_principal_did', true)
  );

COMMENT ON POLICY owner_rw ON control_credential.credential IS
  'Credential owner has full read/write access to their own rows. '
  'Requires: SET LOCAL app.current_principal_did = ''<did>'' before query.';

-- Policy 3: grantee_select — grantees can read credentials they have been granted
DROP POLICY IF EXISTS grantee_select ON control_credential.credential;
CREATE POLICY grantee_select
  ON control_credential.credential
  FOR SELECT
  USING (
    EXISTS (
      SELECT 1
      FROM control_credential.credential_grant cg
      WHERE cg.credential_id = control_credential.credential.id
        AND cg.grantee_id = current_setting('app.current_principal_did', true)
        AND (cg.expires_at IS NULL OR cg.expires_at > now())
    )
  );

COMMENT ON POLICY grantee_select ON control_credential.credential IS
  'Principals with an active, non-expired credential_grant may SELECT the credential row. '
  'Write access is reserved for the owner or agenthive_admin. '
  'Requires: SET LOCAL app.current_principal_did = ''<did>'' before query.';

-- ============================================================
-- 8. Views (from 005-credential.sql — idempotent)
-- ============================================================
CREATE OR REPLACE VIEW control_credential.v_active_credentials AS
SELECT
  c.id,
  c.credential_name,
  c.credential_type,
  c.vault_path,
  vp.slug            AS provider_slug,
  vp.provider_type,
  c.last_rotated_at,
  c.rotation_interval_hours,
  CASE
    WHEN c.rotation_interval_hours IS NULL THEN NULL
    WHEN c.last_rotated_at IS NULL        THEN true
    WHEN c.last_rotated_at + (c.rotation_interval_hours * interval '1 hour') < now() THEN true
    ELSE false
  END                AS rotation_overdue
FROM control_credential.credential c
JOIN control_credential.vault_provider vp ON vp.id = c.vault_provider_id
WHERE c.lifecycle_status = 'active'
  AND vp.lifecycle_status = 'active';

CREATE OR REPLACE VIEW control_credential.v_active_grants AS
SELECT
  cg.id,
  c.credential_name,
  c.credential_type,
  cg.grantee_type,
  cg.grantee_id,
  cg.granted_by,
  cg.expires_at,
  (cg.expires_at IS NOT NULL AND cg.expires_at <= now()) AS is_expired,
  cg.created_at
FROM control_credential.credential_grant cg
JOIN control_credential.credential c ON c.id = cg.credential_id
WHERE c.lifecycle_status = 'active';

-- ============================================================
-- 9. Grants
-- ============================================================
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'agenthive_orchestrator') THEN
    GRANT USAGE ON SCHEMA control_credential TO agenthive_orchestrator;
    GRANT SELECT ON ALL TABLES IN SCHEMA control_credential TO agenthive_orchestrator;
    GRANT INSERT, UPDATE ON control_credential.credential_grant TO agenthive_orchestrator;
    GRANT INSERT         ON control_credential.rotation_log     TO agenthive_orchestrator;
    GRANT UPDATE (last_rotated_at, updated_at) ON control_credential.credential TO agenthive_orchestrator;
    GRANT USAGE ON ALL SEQUENCES IN SCHEMA control_credential TO agenthive_orchestrator;
  END IF;

  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'agenthive_observability') THEN
    GRANT USAGE ON SCHEMA control_credential TO agenthive_observability;
    GRANT SELECT ON ALL TABLES IN SCHEMA control_credential TO agenthive_observability;
  END IF;

  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'agenthive_agency') THEN
    GRANT USAGE ON SCHEMA control_credential TO agenthive_agency;
    GRANT SELECT ON control_credential.credential,
                    control_credential.credential_grant,
                    control_credential.vault_provider,
                    control_credential.v_active_credentials,
                    control_credential.v_active_grants TO agenthive_agency;
  END IF;
END $$;

COMMIT;
-- END SKETCH 011
