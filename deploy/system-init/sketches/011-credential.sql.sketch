-- ============================================================
-- P901 sketch 011 — control_credential RLS policies
-- ============================================================
-- Target DB:  hiveCentral
-- Depends on: 005-credential.sql (control_credential schema fully present)
-- Scope:
--   1. FORCE ROW LEVEL SECURITY on control_credential.credential
--   2. Three policies: admin_bypass / owner_rw / grantee_select
-- ============================================================
-- SECURITY MODEL:
--   control_credential.credential stores metadata about secrets (paths,
--   rotation schedules, vault references) — NOT the secret values themselves.
--   RLS ensures only the owner or an explicitly granted principal can read/write
--   a credential row. vault_provider, credential_grant, and rotation_log are
--   NOT covered by RLS (finding below explains why).
-- ============================================================
-- RLS RISK (Finding 15 + P901 Risk Register):
--   getControlPool() sets search_path = roadmap_proposal,...,public.
--   The schemas control_credential is NOT included.
--   All callers MUST use fully-qualified control_credential.* names
--   or explicitly SET search_path per connection before querying.
--
--   BATCH/CRON RISK: Any batch job or cron querying control_credential.credential
--   MUST execute: SET app.current_principal_did = '<did>' on the connection
--   before any credential query. Without this session var, owner_rw and
--   grantee_select policies will return zero rows (empty resultset, not error).
--   The pool acquisition wrapper in pool-registry.ts MUST assert that
--   app.current_principal_did is set when control_credential queries are issued.
-- ============================================================

BEGIN;

-- ── 1. Enable FORCE ROW LEVEL SECURITY on control_credential.credential ───────
-- FORCE RLS ensures even the table owner (agenthive_admin) must pass the policies.
-- Superusers bypass FORCE RLS automatically via PostgreSQL's built-in behaviour.

ALTER TABLE control_credential.credential ENABLE ROW LEVEL SECURITY;
ALTER TABLE control_credential.credential FORCE ROW LEVEL SECURITY;

-- ── 2. Policy: admin_bypass ───────────────────────────────────────────────────
-- Members of agenthive_admin role bypass all row filters.
-- pg_has_role() respects role inheritance; current_user is the session role.

CREATE POLICY admin_bypass ON control_credential.credential
  AS PERMISSIVE
  FOR ALL
  TO PUBLIC
  USING (
    pg_has_role(current_user, 'agenthive_admin', 'member')
  );

-- ── 3. Policy: owner_rw ───────────────────────────────────────────────────────
-- The principal whose DID matches owner_did can SELECT, INSERT, and UPDATE.
-- DELETE is intentionally excluded — credential deletion is an admin operation.
-- Session prerequisite: SET app.current_principal_did = '<did>' before query.
-- current_setting(..., true) returns NULL if unset (missing_ok=true), which
-- will match no rows rather than throw an error.

CREATE POLICY owner_rw ON control_credential.credential
  AS PERMISSIVE
  FOR ALL
  TO agenthive_orchestrator, agenthive_agency
  USING (
    owner_did = current_setting('app.current_principal_did', true)
  )
  WITH CHECK (
    owner_did = current_setting('app.current_principal_did', true)
  );

-- ── 4. Policy: grantee_select ─────────────────────────────────────────────────
-- A non-owner principal that holds an unexpired credential_grant may SELECT.
-- grantee_id is matched against app.current_principal_did.
-- Read-only: no WITH CHECK clause → INSERT/UPDATE not permitted via this policy.

CREATE POLICY grantee_select ON control_credential.credential
  AS PERMISSIVE
  FOR SELECT
  TO agenthive_orchestrator, agenthive_agency
  USING (
    EXISTS (
      SELECT 1
      FROM control_credential.credential_grant cg
      WHERE cg.credential_id = credential.id
        AND cg.grantee_id    = current_setting('app.current_principal_did', true)
        AND (cg.expires_at IS NULL OR cg.expires_at > now())
    )
  );

-- ── Tables NOT covered by RLS (justification) ─────────────────────────────────
-- vault_provider:   contains non-secret config only; no PII; orchestrator/agency
--                   need full SELECT for bootstrap. RLS not required.
-- credential_grant: grant rows are the RLS enforcement mechanism; adding RLS
--                   on top would require recursive policy evaluation. Not added.
-- rotation_log:     append-only (REVOKE UPDATE/DELETE already enforced by trigger).
--                   Observability principals need full read. RLS not required.

ROLLBACK;
-- ^^^^^ DRY-RUN sentinel. Replace with COMMIT for the production migration.
