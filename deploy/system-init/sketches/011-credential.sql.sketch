-- ============================================================
-- SKETCH 011 — P901: control_credential schema RLS policies
-- Status: SKETCH (not a live migration — emit to numbered migration before applying)
--
-- Scope:
--   AC-2: RLS policies on control_credential.credential
--   AC-10: schema name confirmed as control_credential (not credential)
--
-- Pre-requisites:
--   database/ddl/hivecentral/005-credential.sql (P596) applied to hiveCentral DB.
--   This DDL creates the control_credential schema and all four tables:
--     control_credential.vault_provider
--     control_credential.credential
--     control_credential.credential_grant
--     control_credential.rotation_log
--
-- What 005-credential.sql already provides (DO NOT re-create):
--   All table DDL, indexes, triggers, views, and role grants.
--   The rotation_log append-only enforcement (REVOKE UPDATE,DELETE + trigger).
--   The v_active_credentials and v_active_grants views.
--
-- What this sketch adds:
--   Row-Level Security policies on control_credential.credential.
--   RLS is NOT currently enabled (005-credential.sql omits it).
-- ============================================================

-- ============================================================
-- AC-10 SCHEMA NAME CONFIRMATION
-- ============================================================
-- The actual schema created by 005-credential.sql (P596) is:
--   control_credential    ← CORRECT
--
-- Earlier drafts of P901 erroneously referenced schema "credential".
-- All P901 design docs, ACs, and migration plans have been corrected
-- to use control_credential.* throughout.
--
-- The vault adapter (src/shared/vault/index.ts) routes by AGENTHIVE_VAULT_KIND
-- env var only — it never reads control_credential.vault_provider or
-- control_credential.credential. AC-10 tracks an open issue for this gap.
-- ============================================================

-- ============================================================
-- AC-2: RLS on control_credential.credential
-- ============================================================
-- Design rationale:
--   The credential table stores SECRET REFERENCES (paths/keys, never values).
--   RLS enforces that callers can only see credentials they own or have
--   been explicitly granted access to via credential_grant.
--
-- Three policies (additive — a row passes if ANY policy evaluates to TRUE):
--
--   1. admin_bypass    — superusers and pg_has_role('agenthive_admin') bypass RLS.
--   2. owner_select    — principals matching app.current_principal_did session variable
--                        can SELECT/UPDATE their own credentials.
--   3. grantee_select  — principals with a non-expired credential_grant row may SELECT.
--
-- Usage contract:
--   Every connection that reads control_credential.credential must SET the session
--   variable before the first query:
--     SET LOCAL app.current_principal_did = 'did:agenthive:orchestrator';
--   Batch jobs and cron callers MUST set this variable. The pool acquisition wrapper
--   in getControlPool() should assert it is set before handing out a connection.
--   See Risk Register (AC-5) risk: "RLS breakage: app.current_principal_did absent".
-- ============================================================

BEGIN;

-- Enable RLS. FORCE means even the table owner is subject to the policies
-- unless they are a superuser or carry the BYPASSRLS attribute.
ALTER TABLE control_credential.credential ENABLE ROW LEVEL SECURITY;
ALTER TABLE control_credential.credential FORCE ROW LEVEL SECURITY;

-- ── Policy 1: Admin bypass ────────────────────────────────────────────────────
-- Grants unrestricted access to the agenthive_admin role and PostgreSQL superusers.
-- This is the escape hatch for operational tasks (rotation jobs, bootstrap).
CREATE POLICY credential_admin_bypass
  ON control_credential.credential
  AS PERMISSIVE
  FOR ALL
  TO PUBLIC
  USING (
    pg_has_role(current_user, 'agenthive_admin', 'MEMBER')
    OR current_setting('is_superuser', true) = 'on'
  );

COMMENT ON POLICY credential_admin_bypass ON control_credential.credential IS
  'Admins and superusers bypass RLS. Used by rotation jobs and bootstrap scripts.';

-- ── Policy 2: Owner read/write ────────────────────────────────────────────────
-- A principal may read and update credentials they own (owner_did matches the
-- session variable app.current_principal_did).
-- The session variable is set by the pool acquisition wrapper before any query.
CREATE POLICY credential_owner_rw
  ON control_credential.credential
  AS PERMISSIVE
  FOR ALL
  TO PUBLIC
  USING (
    owner_did = current_setting('app.current_principal_did', true)
  )
  WITH CHECK (
    owner_did = current_setting('app.current_principal_did', true)
  );

COMMENT ON POLICY credential_owner_rw ON control_credential.credential IS
  'Owners (owner_did = app.current_principal_did) may read and update their credentials.';

-- ── Policy 3: Grantee select ──────────────────────────────────────────────────
-- A principal may SELECT credentials for which a non-expired grant exists.
-- Grants are stored in control_credential.credential_grant.
-- Callers cannot write through this policy — they can only read.
CREATE POLICY credential_grantee_select
  ON control_credential.credential
  AS PERMISSIVE
  FOR SELECT
  TO PUBLIC
  USING (
    EXISTS (
      SELECT 1
      FROM control_credential.credential_grant cg
      WHERE cg.credential_id = credential.id
        AND cg.grantee_id = current_setting('app.current_principal_did', true)
        AND (cg.expires_at IS NULL OR cg.expires_at > now())
    )
  );

COMMENT ON POLICY credential_grantee_select ON control_credential.credential IS
  'Principals with a non-expired credential_grant row may SELECT the referenced credential. '
  'Read-only: INSERT/UPDATE/DELETE require ownership or admin access.';

ROLLBACK;
-- ^^^^^^ ROLLBACK for dry-run validation (AC-6). Replace with COMMIT for production emit.

-- ============================================================
-- AC-6 DRY-RUN NOTE
-- ============================================================
-- To validate: psql -d hiveCentral -f this-file
-- Expected output: ROLLBACK (no errors = RLS DDL is syntactically valid)
-- To apply:      replace ROLLBACK with COMMIT and assign a migration number.
-- ============================================================

-- ============================================================
-- AC-7 COMPATIBILITY NOTE
-- ============================================================
-- These RLS policies are ADDITIVE to the existing 005-credential.sql DDL.
-- They do not modify any existing table structure, index, or trigger.
-- Existing queries that run as agenthive_admin will be unaffected
-- (policy 1 bypasses for admin role members).
-- Existing queries that do NOT set app.current_principal_did will see
-- an empty credential table unless they run as admin.
-- Mitigation: audit all code paths that read control_credential.credential
-- before enabling RLS in production; ensure each sets the session variable.
-- ============================================================

-- ============================================================
-- OPEN ISSUE (AC-10): Vault adapter integration gap
-- ============================================================
-- src/shared/vault/index.ts routes by AGENTHIVE_VAULT_KIND env var only.
-- It never reads control_credential.vault_provider or .credential.
-- The credential catalog is thus completely bypassed at runtime.
--
-- Impact: rotation_log cannot be populated automatically; credential
-- staleness detection (v_active_credentials.rotation_overdue) is unused.
--
-- Remediation (out of P901 scope):
--   File a separate proposal to wire the vault adapter's initialise()
--   function to consult control_credential.vault_provider on startup,
--   building the provider registry from the DB rather than env vars.
--   Fall back to AGENTHIVE_VAULT_KIND if the DB is unreachable.
-- ============================================================
