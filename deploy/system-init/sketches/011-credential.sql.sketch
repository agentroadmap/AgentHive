-- SKETCH — NOT applied by apply.sh until P901 approved
-- Central credential catalog with vault abstraction and rotation audit trail
-- Design: all pointers, no plaintext. Vault adapter loads via vault_path.
-- Reference: v3 design §5.3, §9 layer 2 (row-level security)

-- Created as part of P901: central registries (template/credential/workforce) for agentHive2 cross-project share

CREATE SCHEMA IF NOT EXISTS credential;
GRANT USAGE ON SCHEMA credential TO agenthive_orchestrator, agenthive_agency, agenthive_observability;

-- Vault provider configuration (where secrets live)
-- DB stores only pointers and config; plaintext is never in Postgres.
CREATE TABLE credential.vault_provider (
  vault_provider_id TEXT PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('env', 'file', 'vault', 'aws_sm', 'systemd_credential')),
  config JSONB NOT NULL DEFAULT '{}',    -- provider-specific: env var names, file paths, AWS region, Vault addr
  is_enabled BOOLEAN NOT NULL DEFAULT true,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  created_by_did TEXT NOT NULL
);

CREATE INDEX idx_credential_vault_provider_kind ON credential.vault_provider (kind) WHERE is_enabled;

-- Central credential registry
-- Stores metadata and pointers to vault; never plaintext values.
CREATE TABLE credential.credential (
  credential_id BIGSERIAL PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('pg_password', 'api_key', 'oauth_token', 'signing_key', 'ssh_key')),
  vault_provider_id TEXT NOT NULL REFERENCES credential.vault_provider,
  vault_path TEXT NOT NULL,    -- e.g., 'agency/claude-code/signing-key', 'db/admin/pg-password'

  rotation_policy TEXT NOT NULL DEFAULT 'never' CHECK (rotation_policy IN ('never', 'on_demand', 'daily', 'weekly', 'monthly', 'quarterly')),
  last_rotated_at TIMESTAMPTZ,
  next_rotation_at TIMESTAMPTZ,

  -- Catalog hygiene
  owner_did TEXT NOT NULL,
  lifecycle_status TEXT NOT NULL DEFAULT 'active' CHECK (lifecycle_status IN ('active', 'deprecated', 'retired')),
  deprecated_at TIMESTAMPTZ,
  retire_after TIMESTAMPTZ,

  metadata JSONB NOT NULL DEFAULT '{}',
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),

  CHECK (deprecated_at IS NULL OR lifecycle_status IN ('deprecated', 'retired')),
  CHECK (rotation_policy = 'never' OR next_rotation_at IS NOT NULL),
  CHECK (last_rotated_at IS NULL OR last_rotated_at <= now())
);

CREATE INDEX idx_credential_credential_vault_provider ON credential.credential (vault_provider_id);
CREATE INDEX idx_credential_credential_owner ON credential.credential (owner_did);
CREATE INDEX idx_credential_credential_lifecycle ON credential.credential (lifecycle_status);
CREATE INDEX idx_credential_credential_rotation ON credential.credential (next_rotation_at) WHERE rotation_policy != 'never';

-- Row-level security: each principal sees only credentials they have grants for
ALTER TABLE credential.credential ENABLE ROW LEVEL SECURITY;
CREATE POLICY credential_grant_based ON credential.credential
  USING (
    credential_id IN (
      SELECT credential_id FROM credential.credential_grant
      WHERE principal_did = current_setting('app.current_principal_did', true)
    )
  );

-- Credential grants: who can use this credential, for what operations, until when
CREATE TABLE credential.credential_grant (
  grant_id BIGSERIAL PRIMARY KEY,
  credential_id BIGINT NOT NULL REFERENCES credential.credential,
  principal_did TEXT NOT NULL,    -- 'did:agency:claude-code/agency-bot', 'did:hive:orchestrator', etc.
  permitted_ops TEXT[] NOT NULL DEFAULT '{read}' CHECK (permitted_ops <@ '{read,rotate,revoke}'::text[]),

  granted_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  granted_by_did TEXT NOT NULL,
  expires_at TIMESTAMPTZ,

  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  metadata JSONB NOT NULL DEFAULT '{}',

  UNIQUE (credential_id, principal_did),
  CHECK (expires_at IS NULL OR expires_at > granted_at)
);

CREATE INDEX idx_credential_credential_grant_principal ON credential.credential_grant (principal_did, expires_at) WHERE expires_at > now() OR expires_at IS NULL;
CREATE INDEX idx_credential_credential_grant_credential ON credential.credential_grant (credential_id);

-- Rotation audit log (append-only, tamper-evident)
-- Tracks every rotation attempt and outcome for compliance.
CREATE TABLE credential.credential_rotation_log (
  log_id BIGSERIAL PRIMARY KEY,
  credential_id BIGINT NOT NULL REFERENCES credential.credential,
  rotated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  rotated_by_did TEXT NOT NULL,
  outcome TEXT NOT NULL CHECK (outcome IN ('success', 'failure')),
  reason TEXT,    -- success: null | failure: error message
  metadata JSONB NOT NULL DEFAULT '{}'
);

CREATE INDEX idx_credential_credential_rotation_log_credential ON credential.credential_rotation_log (credential_id);
CREATE INDEX idx_credential_credential_rotation_log_date ON credential.credential_rotation_log (rotated_at DESC);

-- Pre-create monthly partitions for rotation log (last 12 months + 3 months ahead)
-- Partition strategy: monthly, retention 24 months
-- Handled by separate partition-maintenance job (P894)

-- Event-sourcing spine: credential mutations are logged in governance.event_log
-- See governance.sql for event_log table definition
-- trigger: credential_write updates governance.event_log in same txn

GRANT SELECT ON credential.credential TO agenthive_orchestrator, agenthive_agency;
GRANT SELECT ON credential.credential_grant TO agenthive_orchestrator;
GRANT SELECT ON credential.vault_provider TO agenthive_orchestrator;
GRANT INSERT ON credential.credential_rotation_log TO agenthive_orchestrator;
GRANT ALL ON credential.credential_rotation_log TO agenthive_observability;

-- Seeding: import existing credentials from /etc/agenthive/env and agency vault
-- This is a manual process for v1 transition (bootstrapping phase):
-- 1. Agency signing keys → credential.credential with vault_provider='vault' or 'systemd_credential'
-- 2. Agency provider creds → credential.credential with appropriate vault_provider
-- 3. Seeded grants: each agency gets read on its own credentials
-- 4. Later waves (v1.1+): migrate DB password rotation to use central credential registry

-- Rollback: DROP SCHEMA credential CASCADE;
