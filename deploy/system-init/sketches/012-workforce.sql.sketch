-- ============================================================
-- SKILL_GRANT_LOG ARCHIVE (365-day retention)
-- ============================================================
-- Recommended cron job (pg_cron or external scheduler):
--   DELETE FROM workforce.skill_grant_log
--   WHERE created_at < now() - interval '365 days';
-- This statement will fail (trigger blocks DELETE). Proper approach:
--   Either use a partition rotation (pg_partman range partition on created_at)
--   or move to an archive table before deleting:
--     INSERT INTO workforce.skill_grant_log_archive SELECT * FROM workforce.skill_grant_log
--       WHERE created_at < now() - interval '365 days';
--     Then DELETE from the partition (if partitioned) or DROP the old partition.
-- The archive table DDL (not yet created):
--   CREATE TABLE IF NOT EXISTS workforce.skill_grant_log_archive
--     (LIKE workforce.skill_grant_log INCLUDING ALL);
--   COMMENT ON TABLE workforce.skill_grant_log_archive IS
--     'Cold storage for skill grant events older than 365 days. Archived by retention cron.';
-- ============================================================

