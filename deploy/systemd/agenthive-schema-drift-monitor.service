[Unit]
Description=AgentHive Schema Drift Monitor
Documentation=https://gitlab.local/agenthive
After=network.target postgresql.service

[Service]
Type=oneshot
User=xiaomi
Group=xiaomi
EnvironmentFile=/etc/agenthive/env
Environment=NODE_ENV=production
Environment=PATH=/home/xiaomi/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/xiaomi
ExecStart=/usr/local/bin/agenthive-schema-drift-monitor.sh
Restart=no
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agenthive-schema-drift-monitor
ProtectSystem=strict
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
