{
  "name": "@agenthive/scan-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Generic hardcoding scanner engine and CLI core (no rules bundled)",
  "main": "./dist/index.js",
  "bin": {
    "scan-hardcoding": "./dist/bin/scan-hardcoding.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./engine": {
      "import": "./dist/engine.js"
    },
    "./rules": {
      "import": "./dist/rules.js"
    },
    "./output": {
      "import": "./dist/output.js"
    },
    "./allowlist": {
      "import": "./dist/allowlist.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/**/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "glob": "^10.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "scan",
    "hardcoding",
    "security",
    "linter",
    "static-analysis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agenthive/scan"
  }
}
